# Normalize line endings in the repository; check out with native endings
* text=auto

# Shell scripts must keep LF even on Windows checkouts
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.webp binary
