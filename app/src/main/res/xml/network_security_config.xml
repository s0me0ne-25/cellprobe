<?xml version="1.0" encoding="utf-8"?>
<!--
    Probes trust the system roots plus extra roots that older Android
    versions lack, so that a valid site is never reported as CERT_INVALID
    just because the device's root store is outdated (e.g. Let's Encrypt
    on Android 7.0).

    raw/extra_roots.pem, taken from the Mozilla CA bundle:
    - ISRG Root X1  SHA-256 96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
    - ISRG Root X2  SHA-256 69:72:9B:8E:15:A8:6E:FC:17:7A:57:AF:B7:17:1D:FC:64:AD:D2:8C:2F:CA:8C:F1:50:7E:34:45:3C:CB:14:70
    - GTS Root R1   SHA-256 D9:47:43:2A:BD:E7:B7:FA:90:FC:2E:6B:59:10:1B:12:80:E0:E1:C7:E4:E4:0F:A3:C6:88:7F:FF:57:A7:F4:CF
    - GTS Root R3   SHA-256 34:D8:A7:3E:E2:08:D9:BC:DB:0D:95:65:20:93:4B:4E:40:E6:94:82:59:6E:8B:6F:73:C8:42:6B:01:0A:6F:48
    - GTS Root R4   SHA-256 34:9D:FA:40:58:C5:E2:63:12:3B:39:8A:E7:95:57:3C:4E:13:13:C8:3F:E6:8F:93:55:6C:D5:E8:03:1B:3C:7D

    User-installed CAs are deliberately not trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/extra_roots" />
        </trust-anchors>
    </base-config>
</network-security-config>
