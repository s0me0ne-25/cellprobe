<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the UI itself is themed by Compose. -->
    <style name="Theme.Cellprobe" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- See-through windows over the current screen: a dialog drawn by Compose, or nothing at all. -->
    <style name="Theme.Cellprobe.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
