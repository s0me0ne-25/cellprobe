    <string name="settings_section_apps">Unblocking apps</string>
    <string name="role_vpn_client">VPN client</string>
    <string name="role_vpn_client_description">Opened under standard blocking.</string>
    <string name="role_vpn_client_about">The main app you connect to a VPN with, such as Hiddify, Happ or Exclave. When you turn on olcRTC or I2P, you may need to switch the profile there by hand as well.</string>
    <string name="role_olcrtc">olcRTC client</string>
    <string name="role_olcrtc_description">Opened in whitelist mode.</string>
    <string name="role_olcrtc_about">olcRTC is a technology built to resist whitelist mode. It carries traffic over video calls in trusted messengers whose servers are officially whitelisted.</string>
    <string name="role_i2p">I2P client</string>
    <string name="role_i2p_description">Opened when VLESS is blocked.</string>
    <string name="role_i2p_about">I2P is a network of tens of thousands of nodes run by volunteers all over the world. Your traffic goes through several of them picked at random. I2P does not work under whitelists but is extremely resilient under standard blocking.</string>
